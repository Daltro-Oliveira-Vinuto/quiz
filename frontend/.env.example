# ==========================================================
# Frontend (Vite) - modelo do arquivo .env
# Copie para .env e preencha:  cp .env.example .env
#
# Atenção: as variáveis VITE_ entram no código no momento do build
# e ficam visíveis no navegador. Nunca coloque senhas aqui.
# ==========================================================

# Endereço da API do backend (termina em /api)
VITE_API_URL=http://localhost:8000/api

# Endereço base do backend e só o domínio (sem http://)
VITE_BACKEND_URL=http://localhost:8000
VITE_BACKEND_DOMAIN=localhost:8000

# Logo mostrada na página inicial: arquivo da pasta public/ ou URL completa
VITE_LOGO_URL=/logo_da_feb.png
