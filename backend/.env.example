# ==========================================================
# Backend (Django) - modelo do arquivo .env
# Copie para .env e preencha:  cp .env.example .env
#
# Comentários ficam sempre na linha de cima da variável:
# um "#" no fim da linha vira parte do valor.
# ==========================================================

# ---------- Django ----------
# True no seu computador, False no servidor
DEBUG=True
# Chave secreta (obrigatória). Gere uma com:
# poetry run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=troque-pela-sua-chave-secreta
# Domínios do backend, separados por vírgula (sem http://)
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------- Frontend que acessa a API ----------
FRONTEND_URL=http://localhost:5173
# Endereços completos (com http:// ou https://), separados por vírgula
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# ---------- Banco de dados ----------
# mysql (padrão, serve também para MariaDB) | outra opção: postgres
DB_ENGINE=mysql
DB_NAME=quiz_db
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
# 3306 para MySQL/MariaDB, 5432 para PostgreSQL
DB_PORT=3306

# Alternativa às variáveis DB_* acima: uma URL única (tem prioridade).
# O tipo da URL precisa bater com o DB_ENGINE.
# DATABASE_URL=mysql://usuario:senha@host:3306/quiz_db
# DATABASE_URL=postgresql://usuario:senha@host:5432/quiz_db

# ---------- Imagens das questões ----------
# Obrigatório quando DEBUG=False (as imagens vão para o Cloudinary).
# Formato: cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_URL=

# ---------- Redis ----------
REDIS_URL=redis://127.0.0.1:6379

# ---------- Login com Google ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback/

# ---------- Superusuário criado no deploy (createsuperuser --noinput) ----------
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=troque-pela-sua-senha-de-admin
